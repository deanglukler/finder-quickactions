				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>apps=()

for app in "Visual Studio Code" "Zed" "Sublime Text" "Xcode"
do
	if [[ -d "/Applications/$app.app" || -d "$HOME/Applications/$app.app" ]]
	then
		apps+=("$app")
	fi
done

if (( ${#apps[@]} == 0 ))
then
	osascript -e 'display alert "Open In" message "No supported editor applications were found." as critical'
	exit 1
fi

choice=$(osascript \
	-e 'on run argv' \
	-e 'set picked to choose from list argv with title "Open In" with prompt "Choose an application:" default items {item 1 of argv}' \
	-e 'if picked is false then return ""' \
	-e 'return item 1 of picked' \
	-e 'end run' \
	-- "${apps[@]}")

if [[ -z "$choice" ]]
then
	exit 0
fi

for folder in "$@"
do
	open -a "$choice" "$folder"
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
